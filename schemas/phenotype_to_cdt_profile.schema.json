{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virelionbiotech.net/schemas/phenotype-to-cdt-profile-1.0.0.json",
  "title": "CardiSim phenotype-to-CDT mapping profile",
  "type": "object",
  "required": ["profile_id", "version", "calibration_status", "rules"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "calibration_status": {"type": "string", "enum": ["uncalibrated", "empirical-fit", "validated", "deprecated", "unknown"]},
    "source": {"type": "string"},
    "notes": {"type": "string"},
    "rules": {
      "type": "object",
      "required": ["fibre_speed", "sheet_speed", "normal_speed", "endo_dense_speed", "endo_sparse_speed", "purkinje_speed", "apd_min", "apd_max"],
      "additionalProperties": false,
      "properties": {
        "fibre_speed": {"$ref": "#/$defs/rule"},
        "sheet_speed": {"$ref": "#/$defs/rule"},
        "normal_speed": {"$ref": "#/$defs/rule"},
        "endo_dense_speed": {"$ref": "#/$defs/rule"},
        "endo_sparse_speed": {"$ref": "#/$defs/rule"},
        "purkinje_speed": {"$ref": "#/$defs/rule"},
        "apd_min": {"$ref": "#/$defs/rule"},
        "apd_max": {"$ref": "#/$defs/rule"}
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["base", "lower", "upper", "weights"],
      "properties": {
        "base": {"type": "number"},
        "lower": {"type": "number"},
        "upper": {"type": "number"},
        "weights": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        }
      }
    }
  }
}
